AWS_REGION=us-west-2

# Pick names that don't collide with anything you already have. Generate a
# random suffix with: python -c 'import secrets; print(secrets.token_hex(4))'
# Bucket names must be globally unique within your account+region.
S3_VECTOR_BUCKET=enterprise-search-demo-CHANGE-ME
S3_VECTOR_INDEX=drive-docs-CHANGE-ME

BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSION=1024
