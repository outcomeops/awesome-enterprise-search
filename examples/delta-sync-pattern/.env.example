# Public HTTPS URL Drive will POST notifications to. Use ngrok during dev:
#   ngrok http 8000
# then take the https URL and append /webhook.
WEBHOOK_CALLBACK_URL=https://<your-tunnel>.ngrok.app/webhook

# Random shared secret. Drive echoes this back as the X-Goog-Channel-Token
# header on every notification — the only way we authenticate the request.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
WEBHOOK_SECRET=replace-me-with-a-long-random-string

# How often the layered sync's reconcile job runs (safety net under the
# webhook). 600 = 10 minutes, a reasonable default.
RECONCILE_INTERVAL_SECONDS=600
