# From your GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match the "Authorization callback URL" in the OAuth App settings.
# In dev with ngrok: https://<your-tunnel>.ngrok.app/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Public URL the GitHub webhook will POST to. ngrok during dev.
WEBHOOK_CALLBACK_URL=http://localhost:8000/webhook
WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Random bytes for Flask session signing. `python -c 'import secrets; print(secrets.token_hex(32))'`
FLASK_SECRET_KEY=
